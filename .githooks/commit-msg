#!/bin/sh
# Enforce Conventional Commits: type(scope)!: summary
# Use `cargo x commit` to write one interactively. Skip with --no-verify.
msg_file="$1"
first=$(head -n1 "$msg_file")
case "$first" in
  Merge*|Revert*|fixup!*|squash!*|amend!*) exit 0 ;;
esac
if ! printf '%s' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$'; then
  echo "✗ Commit message doesn't follow Conventional Commits:" >&2
  echo "    $first" >&2
  echo "" >&2
  echo "  Expected: <type>(<optional scope>): <summary>, e.g." >&2
  echo "    feat(agent): enforce BitLocker on Windows Pro" >&2
  echo "    fix(app): keep username in sync with full name" >&2
  echo "  Types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  Tip: run ./scripts/commit.sh (or 'cargo x commit') for a guided prompt." >&2
  exit 1
fi
