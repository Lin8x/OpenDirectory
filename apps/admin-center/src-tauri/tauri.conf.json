{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDirectory Admin Center",
  "version": "0.7.0",
  "identifier": "dev.opendirectory.admincenter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenDirectory Admin Center",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Directory, Group Policy and endpoint management for every OS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2RjcxNTEzRDgyMzQzRUMKUldUc1F5UFlFeFgzcHBaWDN0OGVCaTBFbkhaaTFWYzVXcVVqZGJ6Yy94a1hEVXFVMVpqVll3TDUK",
      "endpoints": [
        "https://github.com/Lin8x/OpenDirectory/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
