<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows Installer package for the OpenDirectory Endpoint Agent (WiX v5).
  Built by packaging/windows/build-agent-msi.ps1.

  Installs opendirectory-agent.exe to %ProgramFiles%\OpenDirectory, the path
  the agent's own service install uses. With SERVER and TOKEN set it enrolls and
  starts the OpenDirectory Endpoint Agent service, so it deploys unattended
  through Group Policy Software Installation, Intune, ConfigMgr or any RMM:

    msiexec /i OpenDirectory-Agent-windows-x64.msi /qn SERVER=https://dc01.example.com:8443 TOKEN=XXXX-XXXX-XXXX-XXXX FINGERPRINT=<sha256>

  Without them it only copies the binary; run the enrollment command from
  Admin Center > Enrollment afterwards. Uninstalling stops and removes the
  service. Upgrades keep the enrollment (the agent also updates itself from
  the Management Server).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="OpenDirectory Endpoint Agent"
           Manufacturer="OpenDirectory"
           Version="$(var.Version)"
           UpgradeCode="008a9cda-06eb-43be-b144-6c9bc30fae93"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Lin8x/OpenDirectory" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Enrollment, set on the msiexec command line or in an MST transform. -->
    <Property Id="SERVER" Secure="yes" />
    <Property Id="TOKEN" Secure="yes" Hidden="yes" />
    <Property Id="FINGERPRINT" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenDirectory">
        <Component Id="AgentExe" Bitness="always64">
          <File Id="AgentExe" Source="$(var.AgentExe)" Name="opendirectory-agent.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Agent" Title="Endpoint Agent">
      <ComponentRef Id="AgentExe" />
    </Feature>

    <CustomAction Id="EnrollWithFingerprint" FileRef="AgentExe"
                  ExeCommand="enroll --server &quot;[SERVER]&quot; --token &quot;[TOKEN]&quot; --fingerprint &quot;[FINGERPRINT]&quot; --install"
                  Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="Enroll" FileRef="AgentExe"
                  ExeCommand="enroll --server &quot;[SERVER]&quot; --token &quot;[TOKEN]&quot; --install"
                  Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="RemoveService" FileRef="AgentExe"
                  ExeCommand="uninstall"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="EnrollWithFingerprint" After="InstallFiles"
              Condition="SERVER AND TOKEN AND FINGERPRINT AND NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="Enroll" After="InstallFiles"
              Condition="SERVER AND TOKEN AND NOT FINGERPRINT AND NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="RemoveService" Before="RemoveFiles"
              Condition="(REMOVE~=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
